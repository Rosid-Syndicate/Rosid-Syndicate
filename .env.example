# ---------------------------------------------------------------------------
# Public (bundled into the browser build — VITE_ prefix). Required for `npm run build`.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Canonical origin for SEO (canonical, Open Graph, sitemap, robots). Defaults to
# the live custom domain; override only when building for another host.
VITE_SITE_URL=https://www.rosiddai.com
# Cloudflare Turnstile widget key (test key 1x00000000000000000000AA is used if unset)
VITE_TURNSTILE_SITE_KEY=
# Human check on the admin sign-in / reset forms. Leave off unless Supabase
# Authentication → Attack protection → CAPTCHA (Turnstile) is enabled — that is
# what verifies the token; the widget alone adds no security.
VITE_AUTH_CAPTCHA=false
# Show "Continue with Google" on the admin login. Requires the Google provider to
# be enabled in Supabase Authentication → Providers; staff still need to be on
# the allow-list (Admin → Users & roles).
VITE_AUTH_GOOGLE_SIGNIN=false
# Optional GA4 measurement id (analytics is not loaded when empty)
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Server only (Vercel serverless functions). NEVER prefix these with VITE_.
# ---------------------------------------------------------------------------
# Enables enforced Turnstile verification on /api/contact and /api/tender
TURNSTILE_SECRET_KEY=
# Preferred key for API inserts; lets you close direct anon inserts
# (see supabase/migrations/20260919_inquiries_api_only.sql)
SUPABASE_SERVICE_ROLE_KEY=
# Fallbacks if the VITE_ names are not exposed to functions
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email notifications (Resend). CONTACT_EMAIL_FROM must be on a verified domain;
# the default onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=
CONTACT_EMAIL_TO=admin.rosid@gmail.com
CONTACT_EMAIL_FROM=Rosid Syndicates Group <notifications@your-verified-domain.com>

# Distributed rate limiting / duplicate detection (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Extra allowed browser origins for the API, comma separated (previews are auto-allowed)
ALLOWED_ORIGINS=
